module array_;
  logic [1:0][3:0][7:0] mem;
  int i,j;
  initial begin
    for(i=0;i<2;i++) begin
      for(j=0;j<4;j++) begin
        mem[i][j] = j+2;
        $display("mem[%0d][%0d] =%0d",i,j,mem[i][j]);
      end
    end
  end
endmodule
