/*Declare an unpacked array:

logic [7:0] data [3:0];

Store four 8-bit values:

11
22
33
44

Print all four elements.*/

// Code your design here
module unpacked;
  logic [7:0] data[3:0];
  initial begin
    data[0] = 8'h10;
    data[1] = 8'h00;
    data[2] = 8'h01;
    data[3] = 8'h01;
    #1;
    $display("%0h",data[0]);
    $display("%0h",data[1]);
    $display("%0h",data[2]);
    $display("%0h",data[3]);
  end
endmodule
