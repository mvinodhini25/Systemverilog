module real_;
  real a;
  initial begin
    a = 12.5;
    #1;
    $display("%0d",a);
    a = 3.1415;
    #1;
    $display("%0d",a);
    a = -25.75;
    #1;
    $display("%0d",a);
  end
endmodule
